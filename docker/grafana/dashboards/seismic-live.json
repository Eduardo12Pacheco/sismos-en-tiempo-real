  "panels": [
    {
      "id": 1,
      "title": "Events (data clock 24h)",
      "description": "Earthquakes stored in the last 24 hours of the data clock, where the newest stored event counts as now.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT count() AS \"Events\"\nFROM seismic.events_latest\nWHERE event_time >= (SELECT max(event_time) FROM seismic.events_latest)\n        - INTERVAL 24 HOUR\n  AND magnitude >= $min_mag",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No events stored yet",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
