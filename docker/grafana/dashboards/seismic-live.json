    {
      "id": 9,
      "title": "Magnitude histogram",
      "description": "Stored events in 0.5-magnitude bins; useful to spot aftershock clusters.",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
