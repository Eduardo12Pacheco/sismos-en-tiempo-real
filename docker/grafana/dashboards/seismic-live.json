      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT floor(magnitude * 2) / 2 AS \"Magnitude bin\", count() AS \"Events\"\nFROM seismic.events_latest\nWHERE magnitude >= $min_mag\nGROUP BY \"Magnitude bin\"\nORDER BY \"Magnitude bin\" ",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.23.5"
