    {
      "id": 7,
      "title": "Events per hour (stream windows)",
      "description": "Sum of the processor's 1-hour tumbling-window counts, shifted to the data clock so the replay history fills the last 24 hours.",
      "type": "timeseries",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "WITH (\n    SELECT max(event_time) FROM seismic.events_latest\n) AS data_now,\ndateDiff('second', data_now, now()) AS shift_seconds\nSELECT\n    window_start + toIntervalSecond(shift_seconds) AS \"time\",\n    sum(event_count) AS \"Events\"\nFROM seismic.window_stats_latest\nGROUP BY window_start\nORDER BY window_start",
          "queryType": "timeseries",
          "format": 0,
          "pluginVersion": "4.23.5"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No stream windows in this data window",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "tags": [
        "expect_data",
        "seismic"
      ]
    },
    {
      "id": 8,
      "title": "Top regions",
      "description": "Regions with the most stored events in the data window (top 10).",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
