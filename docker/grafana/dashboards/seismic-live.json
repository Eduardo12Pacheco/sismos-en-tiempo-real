          "editorType": "sql",
          "rawSql": "SELECT latitude, longitude, magnitude, depth_km, place\nFROM seismic.events_latest\nWHERE magnitude >= $min_mag\nORDER BY event_time DESC\nLIMIT 500",
          "queryType": "table",
          "format": 1,
