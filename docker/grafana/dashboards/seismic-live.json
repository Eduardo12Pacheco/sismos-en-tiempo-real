    {
      "id": 12,
      "title": "Ecuador region watch",
      "description": "Events inside the documented Ecuador bounding box (including Galapagos), with an explicit empty state for data windows without local activity.",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "WITH (\n    SELECT max(event_time) FROM seismic.events_latest\n) AS data_now,\ndateDiff('second', data_now, now()) AS shift_seconds\nSELECT\n    event_time + toIntervalSecond(shift_seconds) AS \"time\",\n    round(magnitude, 1) AS \"Magnitude\",\n    place AS \"Place\",\n    round(depth_km, 1) AS \"Depth (km)\",\n    detail_url AS \"detail_url\"\nFROM seismic.events_latest\nWHERE in_ecuador_region = 1\n  AND magnitude >= $min_mag\nORDER BY event_time DESC\nLIMIT 50",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "fieldConfig": {
        "defaults": {
