          "editorType": "sql",
          "rawSql": "SELECT region AS \"Region\", count() AS \"Events\"\nFROM seismic.events_latest\nWHERE magnitude >= $min_mag\nGROUP BY region\nORDER BY count() DESC\nLIMIT 10",
