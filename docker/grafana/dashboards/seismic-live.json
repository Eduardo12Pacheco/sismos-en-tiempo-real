    {
      "id": 10,
      "title": "Latest alerts",
      "description": "Newest alerts with the USGS detail link behind the detail_url column; rows are limited to the selected minimum magnitude.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "WITH (\n    SELECT max(event_time) FROM seismic.events_latest\n) AS data_now,\ndateDiff('second', data_now, now()) AS shift_seconds\nSELECT\n    a.event_time + toIntervalSecond(shift_seconds) AS \"time\",\n    a.level AS \"Level\",\n    round(a.magnitude, 1) AS \"Magnitude\",\n    a.place AS \"Place\",\n    a.reason AS \"Reason\",\n    e.detail_url AS \"detail_url\"\nFROM seismic.alerts_latest AS a\nLEFT JOIN seismic.events_latest AS e ON a.event_id = e.event_id\nWHERE a.magnitude >= $min_mag\nORDER BY a.event_time DESC\nLIMIT 50",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No alerts in this data window",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "WATCH": {
                        "color": "orange",
                        "index": 0
                      },
                      "WARNING": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "detail_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open USGS event",
                    "url": "${__data.fields.detail_url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "time"
          }
        ]
      },
      "tags": [
        "expect_data",
        "seismic"
      ]
    },
    {
