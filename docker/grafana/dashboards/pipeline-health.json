    {
      "id": 7,
      "title": "End-to-end latency p50/p95",
      "description": "Median and 95th percentile latency from the ingest timestamp Kafka header to the stored ClickHouse row, computed from the sink histogram.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(seismic_sink_end_to_end_seconds_bucket[5m])))",
          "instant": false,
          "range": true,
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(seismic_sink_end_to_end_seconds_bucket[5m])))",
          "instant": false,
          "range": true,
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No latency samples",
          "decimals": 1
        },
        "overrides": []
