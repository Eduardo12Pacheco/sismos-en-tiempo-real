    {
      "id": 4,
      "title": "Replay schedule lag",
      "description": "Seconds by which the replay pacer is behind its schedule; zero at maximum speed and while the one-shot ingest is not running.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(seismic_replay_schedule_lag_seconds) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "schedule lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No replay running",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
