    {
      "id": 12,
      "title": "Latest dead letters",
      "description": "Newest rows from the ClickHouse dead_letters table, including the preserved payload metadata for triage.",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n    failed_at AS \"time\",\n    stage AS \"Stage\",\n    error_type AS \"Error type\",\n    error_message AS \"Message\",\n    source_topic AS \"Source topic\",\n    attempts AS \"Attempts\"\nFROM seismic.dead_letters_latest\nORDER BY failed_at DESC\nLIMIT 50",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No dead letters stored",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "time"
          }
        ]
      },
      "tags": [
        "health"
      ]
