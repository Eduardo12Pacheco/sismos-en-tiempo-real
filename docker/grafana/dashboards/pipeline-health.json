    {
      "id": 5,
      "title": "Throughput",
      "description": "Ingest publish rate and sink row rate per second over a one-minute Prometheus window.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(seismic_ingest_records_total[1m]))",
          "instant": false,
          "range": true,
          "legendFormat": "ingest events/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(seismic_sink_rows_total[1m]))",
          "instant": false,
          "range": true,
          "legendFormat": "sink rows/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No throughput data",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "tags": [
        "expect_data",
        "throughput"
      ]
