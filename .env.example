# realtime-seismic-stream configuration.
# Copy to `.env` (the installer creates it automatically) and adjust as needed.
# Every variable is optional; the values below are the local-development defaults.

# --- Broker and schema registry -------------------------------------------------
# Image tag built locally by Compose; never pushed to a registry.
SEISMIC_IMAGE=realtime-seismic-stream:local
# Kafka API endpoint exposed by the Redpanda container.
SEISMIC_KAFKA_BOOTSTRAP=localhost:19092
# Confluent-compatible Schema Registry endpoint exposed by Redpanda
# (container listener 18081, host mapping 13081 per the portfolio port range).
SEISMIC_SCHEMA_REGISTRY_URL=http://localhost:13081

# --- ClickHouse ----------------------------------------------------------------
SEISMIC_CLICKHOUSE_HOST=localhost
SEISMIC_CLICKHOUSE_PORT=8123
SEISMIC_CLICKHOUSE_USER=seismic
# Development-only credential. Replace it for any non-local deployment.
SEISMIC_CLICKHOUSE_PASSWORD=seismic-local
SEISMIC_CLICKHOUSE_DATABASE=seismic

# --- Ingest source -------------------------------------------------------------
# `replay` reads the bundled recorded sample; `usgs` polls the live feed.
SEISMIC_INGEST_SOURCE=replay
# Recorded GeoJSON FeatureCollection or NDJSON of GeoJSON Features.
SEISMIC_REPLAY_FILE=data/samples/usgs_2026-11-02_2026-11-09_m1.geojson
# Compression multiplier (> 0), or `max` to disable pacing entirely.
SEISMIC_REPLAY_SPEED=1440
# Deterministic fault injection (malformed copies, duplicates, revisions).
SEISMIC_REPLAY_CHAOS=false
SEISMIC_CHAOS_SEED=42
# Probabilities in [0, 1].
SEISMIC_CHAOS_MALFORMED_RATE=0.02
SEISMIC_CHAOS_DUPLICATE_RATE=0.05
SEISMIC_CHAOS_REVISION_RATE=0.02

# --- Optional USGS live feed ---------------------------------------------------
# One of: all_hour, all_day, all_week, 2.5_hour, 2.5_day, 4.5_hour, 4.5_day,
# significant_hour, significant_day.
SEISMIC_LIVE_FEED=all_hour
# USGS guidance requires at least 60 seconds between polls.
SEISMIC_LIVE_POLL_SECONDS=60

# --- Processing ----------------------------------------------------------------
# Comma-separated USGS event types to publish (everything else is filtered).
SEISMIC_INCLUDE_EVENT_TYPES=earthquake
# Alert thresholds (magnitude).
SEISMIC_ALERT_WARNING_MAG=6.0
SEISMIC_ALERT_WATCH_MAG=5.0
SEISMIC_ALERT_ECUADOR_MAG=4.0
# Event-time tumbling window and allowed lateness.
SEISMIC_WINDOW_MINUTES=60
SEISMIC_WINDOW_GRACE_MINUTES=10
# Directory for the processor's local state.
SEISMIC_STATE_DIR=./.state

# --- Sink, retries and producer backpressure -----------------------------------
SEISMIC_SINK_BATCH_SIZE=500
SEISMIC_SINK_BATCH_MAX_WAIT_SECONDS=1.0
SEISMIC_RETRY_BASE_SECONDS=0.5
SEISMIC_RETRY_MAX_SECONDS=30
SEISMIC_PRODUCER_QUEUE_MAX_MESSAGES=10000

# --- Observability -------------------------------------------------------------
# Each service command injects its own default (ingest 9101, processor 9102,
# sink 9103, monitor 9104); set this to override it.
SEISMIC_METRICS_PORT=9101
# Comma-separated consumer groups watched by `seismic-stream monitor`.
SEISMIC_MONITOR_GROUPS=seismic-processor,seismic-sink
SEISMIC_MONITOR_INTERVAL_SECONDS=5
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
SEISMIC_LOG_LEVEL=INFO
# `json` for structured production logs or `console` for human-readable dev logs.
SEISMIC_LOG_FORMAT=json
